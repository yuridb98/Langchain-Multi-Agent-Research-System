# Copy this file to .env for local development (CLI or `streamlit run`).
# Never commit the real .env file -- it is already listed in .gitignore.

OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...

# Optional overrides (defaults shown)
# REQUEST_TIMEOUT_SECONDS=30
# MAX_LLM_RETRIES=2
# MAX_TOPIC_CHARS=300
# SCRAPE_CHAR_LIMIT=5000
# MAX_RUNS_PER_SESSION=10
# WRITER_MAX_TOKENS=2000
